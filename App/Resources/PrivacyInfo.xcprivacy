<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app's own first-party code does not contact tracking domains; all
       IDFA/cross-app tracking is performed by the GoogleMobileAds SDK, which
       ships its own privacy manifest declaring NSPrivacyTracking=true and its
       tracking domains. Apple aggregates that with this app manifest, so this
       one stays false. (Apple rejects NSPrivacyTracking=true with an empty
       NSPrivacyTrackingDomains — ITMS-91064.) -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <!-- Required-reason API declarations for APIs the app itself calls. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- UserDefaults (SettingsFeature persistence). -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
    <dict>
      <!-- File timestamp APIs (image cache LRU access dates, imported file attrs). -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
